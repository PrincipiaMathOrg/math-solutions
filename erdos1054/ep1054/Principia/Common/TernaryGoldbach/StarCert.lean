/-- The grid numerators: `g_j = h_{j mod 32}·2^{⌊j/32⌋}` (over `10⁵`). -/
def gN (j : ℕ) : ℕ := hL.getD (j % 32) 0 * 2 ^ (j / 32)

/-- The grid `g_j ∈ ℚ`. -/
def gQ (j : ℕ) : ℚ := (gN j : ℚ) / 100000

/-- The lower exponential table `el_j`. -/
def elQ (j : ℕ) : ℚ := (elL.getD j 0 : ℚ) / 10 ^ 15

/-- The upper exponential table `eh_j`. -/
def ehQ (j : ℕ) : ℚ := (ehL.getD j 0 : ℚ) / 10 ^ 15

/-- The step minorant `m_c` (`0` beyond the last cell). -/
def mQ (i : ℕ) : ℚ := (mL.getD i 0 : ℚ) / 10 ^ 12

/-- The cut points in `t`: `a_c = g_c/49`. -/
def aQ (i : ℕ) : ℚ := gQ i / 49

/-- The base points increase, and `h_31 < 2h_0` (so the grid increases across octaves). -/
theorem hL_ok : (∀ r < 31, hL.getD r 0 < hL.getD (r + 1) 0) ∧ hL.getD 31 0 < 2 * hL.getD 0 0 := by
  decide +kernel

/-- **The chain's base**, decided. -/
theorem base_ok : SC.BaseOK gQ elQ ehQ := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- **Every step of the exponential chain**, decided: 208 steps. -/
theorem chain_ok : ∀ j < 208, SC.StepOK gQ elQ ehQ j := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- **Every cell**, decided: `0 ≤ S_c` and `m_c ≤ (4S_c)²`. -/
theorem cells_ok : ∀ c < 146, 0 ≤ SC.cellS gQ elQ ehQ 32 c ∧
    mQ c ≤ (4 * SC.cellS gQ elQ ehQ 32 c) ^ 2 := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- **The Abel sum**, decided: `abelQ(0.92079, 1.11) ≥ 0.0153`. -/
theorem abel_ok : (153 : ℚ) / 10000 ≤ SC.abelQ (92079 / 100000) (111 / 100) aQ mQ 146 := by
  decide +kernel

/-- `a_0 = 1/400`. -/
theorem aQ_zero : aQ 0 = 1 / 400 := by
  decide +kernel

/-- **The grid doubles every octave**: `g_{j+32} = 2g_j`. -/
theorem gQ_dbl (j : ℕ) : gQ (j + 32) = 2 * gQ j := by
  have e1 : (j + 32) % 32 = j % 32 := Nat.add_mod_right j 32
  have e2 : (j + 32) / 32 = j / 32 + 1 := Nat.add_div_right j (by norm_num)
  unfold gQ gN
  rw [e1, e2, pow_succ]
  push_cast
  ring

/-- **The grid increases everywhere** (`hL_ok`; `omega` does the octave arithmetic). -/
theorem gN_lt (j : ℕ) : gN j < gN (j + 1) := by
  unfold gN
  rcases Nat.lt_or_ge (j % 32) 31 with h | h
  · have e1 : (j + 1) % 32 = j % 32 + 1 := by omega
    have e2 : (j + 1) / 32 = j / 32 := by omega
    rw [e1, e2]
    exact Nat.mul_lt_mul_of_pos_right (hL_ok.1 _ h) (by positivity)
  · have h31 : j % 32 = 31 := by omega
    have e1 : (j + 1) % 32 = 0 := by omega
    have e2 : (j + 1) / 32 = j / 32 + 1 := by omega
    rw [e1, e2, h31, pow_succ]
    calc hL.getD 31 0 * 2 ^ (j / 32) < 2 * hL.getD 0 0 * 2 ^ (j / 32) :=
          Nat.mul_lt_mul_of_pos_right hL_ok.2 (by positivity)
      _ = hL.getD 0 0 * (2 ^ (j / 32) * 2) := by ring

/-- `a_i ≤ a_{i+1}` for every `i`. -/
theorem aQ_le (i : ℕ) : aQ i ≤ aQ (i + 1) := by
  unfold aQ gQ
  have h : (gN i : ℚ) ≤ gN (i + 1) := by exact_mod_cast (gN_lt i).le
  have h2 : (gN i : ℚ) / 100000 ≤ gN (i + 1) / 100000 := by linarith
  linarith

/-- `m_i ≥ 0`. -/
theorem mQ_nonneg (i : ℕ) : 0 ≤ mQ i := by
  unfold mQ
  positivity

