/-- **The kernel certificate**: every integer of `[6, 469 615]` is `7`, a `j = 1` mark of
`smallBs`, or a witness of `smallWs`, and every entry passes its test. -/
theorem smallChk_cert : smallChk (primeBits 469615) smallBs smallWs 6 469615 = true := by
  decide +kernel

/-- **Check 1 of `verify.rs` on `[6, 469 615]`**: every `N ∈ [6, 469 615]`, `N ≠ 7`, is
`σ(B) + q ∑_{i ≤ j} d_i(B)` with `1 ≤ B ≤ 1000`, `q > B` prime, `1 ≤ j ≤ τ(B)`. This is
`Comp_Verifier_small` restricted to `N ≤ 469 615`, verbatim. -/
theorem smallSieveMarked_le : ∀ N : ℕ, 6 ≤ N → N ≤ 469615 → N ≠ 7 → smallSieveMarked N :=
  marked_of_smallChk smallChk_cert

/-- **Every `N ∈ [6, 469 615]` is represented**, from the spine's two leaves for this window. -/
theorem mem_R_le_of_leaves (hBq : Step_FraitureSmallBq) (h7 : Step_FraitureSeven) :
    ∀ N : ℕ, 6 ≤ N → N ≤ 469615 → N ∈ R := by
  intro N h6 hN
  by_cases h : N = 7
  · subst h
    exact ⟨4, by norm_num, h7⟩
  · exact mem_R_of_marked hBq (smallSieveMarked_le N h6 hN h)

/-- **`eq:fraiture-small` from the first prime window.** `Eq_FraitureSmall` with the spine's
`Comp_Verifier_small` binder replaced by `Eq_FraitureFirstWindow`: `[6, 469 615]` by the
certificate, `[469 616, 10^7]` by the first window. -/
theorem eq_FraitureSmall_of_leaves (hBq : Step_FraitureSmallBq) (h7 : Step_FraitureSeven)
    (hW : Eq_FraitureFirstWindow) : Eq_FraitureSmall := by
  intro N h6 hN
  rcases Nat.lt_or_ge N 469616 with h | h
  · exact mem_R_le_of_leaves hBq h7 N h6 (by omega)
  · have h7' : (10 : ℕ) ^ 7 = 10000000 := by norm_num
    exact hW N h (by omega)

end Principia.Erdos1054.Alt7.Small
