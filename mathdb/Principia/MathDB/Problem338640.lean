/-- `bitsetOf L` has bit `t` set exactly when `t ∈ L`. -/
def bitsetOf : List ℕ → ℕ
  | [] => 0
  | m :: r => (2 ^ m) ||| bitsetOf r

/-- The certified family, as a single natural number. -/
def Bm : ℕ := bitsetOf certMasks

def inB (t : ℕ) : Bool := Bm.testBit t

theorem testBit_bitsetOf (L : List ℕ) (t : ℕ) :
    (bitsetOf L).testBit t = true ↔ t ∈ L := by
  induction L with
  | nil => simp [bitsetOf]
  | cons m r ih =>
    rw [bitsetOf, Nat.testBit_lor, Nat.testBit_two_pow]
    simp only [Bool.or_eq_true, ih, List.mem_cons, decide_eq_true_eq]
    tauto

theorem inB_iff (t : ℕ) : inB t = true ↔ t ∈ certMasks := by
  rw [inB, Bm, testBit_bitsetOf]

/-- The bitset of every 7-mask. -/
def S7 : ℕ := bitsetOf sevens

def inS7 (t : ℕ) : Bool := S7.testBit t

theorem inS7_iff (t : ℕ) : inS7 t = true ↔ t ∈ sevens := by
  rw [inS7, S7, testBit_bitsetOf]

/-! ### The finite checks -/

/-- A `Bool`-valued strict-sortedness test, linear in the length. -/
def strictSorted : List ℕ → Bool
  | [] => true
  | [_] => true
  | a :: b :: r => decide (a < b) && strictSorted (b :: r)

theorem lt_of_strictSorted : ∀ (a : ℕ) (L : List ℕ), strictSorted (a :: L) = true →
    ∀ x ∈ L, a < x := by
  intro a L
  induction L generalizing a with
  | nil => intro _ x hx; simp at hx
  | cons b r ih =>
    intro h x hx
    rw [strictSorted, Bool.and_eq_true, decide_eq_true_eq] at h
    rcases List.mem_cons.mp hx with rfl | hx'
    · exact h.1
    · exact lt_trans h.1 (ih b h.2 x hx')

theorem nodup_of_strictSorted : ∀ (L : List ℕ), strictSorted L = true → L.Nodup := by
  intro L
  induction L with
  | nil => intro _; simp
  | cons a r ih =>
    intro h
    refine List.nodup_cons.mpr ⟨fun hmem => ?_, ih ?_⟩
    · exact absurd (lt_of_strictSorted a r h a hmem) (lt_irrefl a)
    · cases r with
      | nil => rfl
      | cons b t =>
        rw [strictSorted, Bool.and_eq_true] at h
        exact h.2

theorem sevens_sorted : strictSorted sevens = true := by decide

theorem sevens_nodup : sevens.Nodup := nodup_of_strictSorted _ sevens_sorted

theorem sevens_len : sevens.length = 6435 := by decide

theorem sevens_ok : sevens.all (fun s => decide (s < 32768) && decide (popc s = 7)) = true := by
  decide

theorem cert_sorted : strictSorted certMasks = true := by decide

theorem cert_nodup : certMasks.Nodup := nodup_of_strictSorted _ cert_sorted

theorem cert_len : certMasks.length = 1173 := by decide

/-- Every certified mask is a 7-mask. -/
theorem cert_sub : certMasks.all inS7 = true := by decide

/-- **Intersecting**, by the complement reformulation: 1173 x 8 lookups. -/
theorem cert_inter : certMasks.all (fun m => (codel m).all (fun t => !inB t)) = true := by decide

/-- **Maximal**: every one of the 6435 seven-masks is listed or is disjoint from a listed one. -/
theorem cert_max : sevens.all (fun s => inB s || (codel s).any inB) = true := by decide

/-! ### Consequences of the checks -/

theorem mem_sevens_lt {s : ℕ} (hs : s ∈ sevens) : s < 32768 := by
  have := List.all_eq_true.mp sevens_ok s hs
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  exact this.1

theorem mem_sevens_popc {s : ℕ} (hs : s ∈ sevens) : popc s = 7 := by
  have := List.all_eq_true.mp sevens_ok s hs
  simp only [Bool.and_eq_true, decide_eq_true_eq] at this
  exact this.2

theorem mem_cert_sevens {m : ℕ} (hm : m ∈ certMasks) : m ∈ sevens :=
  (inS7_iff m).mp (List.all_eq_true.mp cert_sub m hm)

theorem mem_cert_lt {m : ℕ} (hm : m ∈ certMasks) : m < 32768 :=
  mem_sevens_lt (mem_cert_sevens hm)

theorem mem_cert_card {m : ℕ} (hm : m ∈ certMasks) : (dec m).card = 7 := by
  rw [card_dec]
  exact mem_sevens_popc (mem_cert_sevens hm)

/-- Completeness of `sevens`: every 7-subset of `Fin 15` is listed. -/
theorem enc_mem_sevens (S : Finset (Fin 15)) (hS : S.card = 7) : enc S ∈ sevens := by
  classical
  set A : Finset ℕ := ((univ : Finset (Fin 15)).powersetCard 7).image enc with hA
  have hencinj : Function.Injective (enc : Finset (Fin 15) → ℕ) := by
    intro x y h
    rw [← dec_enc x, ← dec_enc y, h]
  have hcardA : A.card = 6435 := by
    rw [hA, Finset.card_image_of_injective _ hencinj, Finset.card_powersetCard]
    decide
  have hcardB : sevens.toFinset.card = 6435 := by
    rw [List.toFinset_card_of_nodup sevens_nodup, sevens_len]
  have hBA : sevens.toFinset ⊆ A := by
    intro t ht
    rw [List.mem_toFinset] at ht
    refine Finset.mem_image.mpr ⟨dec t, ?_, enc_dec t (mem_sevens_lt ht)⟩
    refine Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, ?_⟩
    rw [card_dec]
    exact mem_sevens_popc ht
  have hAB : A = sevens.toFinset :=
    (Finset.eq_of_subset_of_card_le hBA (by rw [hcardA, hcardB])).symm
  have hmemA : enc S ∈ A :=
    Finset.mem_image.mpr ⟨S, Finset.mem_powersetCard.mpr ⟨Finset.subset_univ _, hS⟩, rfl⟩
  rw [hAB, List.mem_toFinset] at hmemA
  exact hmemA

/-! ### The bicommutative system -/

/-- An `s`-bicommutative system on `[15]`: a maximal intersecting `s`-uniform family. -/
def Bicomm (s : ℕ) (T : Finset (Finset (Fin 15))) : Prop :=
  (∀ A ∈ T, A.card = s) ∧
  (∀ A ∈ T, ∀ B ∈ T, (A ∩ B).Nonempty) ∧
  (∀ S : Finset (Fin 15), S.card = s → S ∉ T → ∃ A ∈ T, Disjoint A S)

/-- The certified family, as a family of subsets. -/
noncomputable def Fam : Finset (Finset (Fin 15)) := certMasks.toFinset.image dec

theorem mem_Fam {A : Finset (Fin 15)} : A ∈ Fam ↔ ∃ m ∈ certMasks, dec m = A := by
  simp [Fam, Finset.mem_image, List.mem_toFinset]

theorem Fam_card : Fam.card = 1173 := by
  rw [Fam, Finset.card_image_of_injOn, List.toFinset_card_of_nodup cert_nodup, cert_len]
  intro a ha b hb h
  simp only [Finset.mem_coe, List.mem_toFinset] at ha hb
  exact dec_inj a b (mem_cert_lt ha) (mem_cert_lt hb) h

theorem Fam_bicomm : Bicomm 7 Fam := by
  refine ⟨?_, ?_, ?_⟩
  · intro A hA
    obtain ⟨m, hm, rfl⟩ := mem_Fam.mp hA
    exact mem_cert_card hm
  · intro A hA B hB
    obtain ⟨a, ha, rfl⟩ := mem_Fam.mp hA
    obtain ⟨b, hb, rfl⟩ := mem_Fam.mp hB
    by_contra hcon
    rw [Finset.not_nonempty_iff_eq_empty, ← Finset.disjoint_iff_inter_eq_empty] at hcon
    have hmem : b ∈ codel a :=
      mem_codel_of_disjoint a b (mem_cert_lt ha) (mem_cert_lt hb)
        (mem_cert_card ha) (mem_cert_card hb) hcon.symm
    have h1 : (!inB b) = true :=
      List.all_eq_true.mp (List.all_eq_true.mp cert_inter a ha) b hmem
    have h2 : inB b = true := (inB_iff b).mpr hb
    simp [h2] at h1
  · intro S hS hnot
    have hmem : enc S ∈ sevens := enc_mem_sevens S hS
    have hchk := List.all_eq_true.mp cert_max (enc S) hmem
    rcases Bool.or_eq_true_iff.mp hchk with h | h
    · exfalso
      apply hnot
      refine mem_Fam.mpr ⟨enc S, (inB_iff _).mp h, dec_enc S⟩
    · obtain ⟨t, ht, hbt⟩ := List.any_eq_true.mp h
      refine ⟨dec t, mem_Fam.mpr ⟨t, (inB_iff t).mp hbt, rfl⟩, ?_⟩
      have := disjoint_of_mem_codel (enc S) t ht
      rwa [dec_enc S] at this

/-- The source's own count of its family `A_7`, re-done. -/
theorem source_size :
    7 * Nat.choose 8 4 + Nat.choose 7 2 * Nat.choose 8 5
      + 7 * Nat.choose 8 6 + Nat.choose 8 7 = 1870 := by decide

/-- **The conjecture is false**: a 7-bicommutative system on `[15]` of size `1173 < 1870`. -/
theorem main : ∃ T : Finset (Finset (Fin 15)), Bicomm 7 T ∧ T.card < 1870 :=
  ⟨Fam, Fam_bicomm, by rw [Fam_card]; norm_num⟩

