/-- The certificate at `n = 25`: swapping rows 0 and 1 factors the matrix.
Pivoting is forced, not cosmetic: `A25 0 0 = s 0 = 0`. -/
theorem A25_factor : A25.submatrix (Equiv.swap 0 1) id = L25 * U25 := by
  decide +kernel

-- stated on the TRANSPOSE so the block map is `id`: the lower-triangular lemma
-- routes through `OrderDual.toDual`, which `decide` has no reason to reduce
-- `BlockTriangular` is a def with STRICT-IMPLICIT binders, so instance search cannot
-- see through it and `Decidable (M.BlockTriangular id)` fails to synthesize.  State
-- the same fact with EXPLICIT binders, decide that, and convert.
theorem L25_upperT : (L25ᵀ).BlockTriangular id := by
  have h : ∀ i j : Fin 25, id j < id i → (L25ᵀ) i j = 0 := by decide +kernel
  exact fun {i j} hij => h i j hij

theorem U25_upper : (U25).BlockTriangular id := by
  have h : ∀ i j : Fin 25, id j < id i → U25 i j = 0 := by decide +kernel
  exact fun {i j} hij => h i j hij

theorem det_L25 : L25.det = 1 := by
  rw [← Matrix.det_transpose, Matrix.det_of_upperTriangular L25_upperT]
  decide +kernel

theorem det_U25 : U25.det = 738 := by
  rw [Matrix.det_of_upperTriangular U25_upper]
  decide +kernel

/-- `H 25 = -738`. -/
theorem det_A25 : A25.det = (-738) := by
  have h := Matrix.det_permute (Equiv.swap (0 : Fin 25) 1) A25
  rw [A25_factor, Matrix.det_mul, det_L25, det_U25,
    Equiv.Perm.sign_swap (by decide : (0 : Fin 25) ≠ 1)] at h
  norm_num at h
  linarith

/-- The certificate at `n = 26`: swapping rows 0 and 1 factors the matrix.
Pivoting is forced, not cosmetic: `A26 0 0 = s 0 = 0`. -/
theorem A26_factor : A26.submatrix (Equiv.swap 0 1) id = L26 * U26 := by
  decide +kernel

-- stated on the TRANSPOSE so the block map is `id`: the lower-triangular lemma
-- routes through `OrderDual.toDual`, which `decide` has no reason to reduce
-- `BlockTriangular` is a def with STRICT-IMPLICIT binders, so instance search cannot
-- see through it and `Decidable (M.BlockTriangular id)` fails to synthesize.  State
-- the same fact with EXPLICIT binders, decide that, and convert.
theorem L26_upperT : (L26ᵀ).BlockTriangular id := by
  have h : ∀ i j : Fin 26, id j < id i → (L26ᵀ) i j = 0 := by decide +kernel
  exact fun {i j} hij => h i j hij

theorem U26_upper : (U26).BlockTriangular id := by
  have h : ∀ i j : Fin 26, id j < id i → U26 i j = 0 := by decide +kernel
  exact fun {i j} hij => h i j hij

theorem det_L26 : L26.det = 1 := by
  rw [← Matrix.det_transpose, Matrix.det_of_upperTriangular L26_upperT]
  decide +kernel

theorem det_U26 : U26.det = (-351) := by
  rw [Matrix.det_of_upperTriangular U26_upper]
  decide +kernel

/-- `H 26 = 351`. -/
theorem det_A26 : A26.det = 351 := by
  have h := Matrix.det_permute (Equiv.swap (0 : Fin 26) 1) A26
  rw [A26_factor, Matrix.det_mul, det_L26, det_U26,
    Equiv.Perm.sign_swap (by decide : (0 : Fin 26) ≠ 1)] at h
  norm_num at h
  linarith

/-- **MathDB #375936 — Sobolewski–Ulas Conjecture 4.7 is FALSE.**  Both `25` and `26` lie in
`[ν 4, 33] = [22, 33]`, where `|H|` is asserted strictly increasing, yet
`|H 25| = 738 > 351 = |H 26|`. -/
theorem main : |A25.det| > |A26.det| := by
  rw [det_A25, det_A26]
  norm_num

/-- The number of ones in the binary expansion of `a` — the write-up's `s`. -/
def s (a : ℕ) : ℕ := (Nat.digits 2 a).sum

/-- The explicit tables really are the binary-digit-sum Hankel matrices.  This is the only
declaration that asks the kernel to evaluate `Nat.digits`, which is defined by well-founded
recursion, so it is placed LAST: every determinant fact above is measured regardless. -/
theorem A25_is_hankel : ∀ i j : Fin 25, A25 i j = (s (i.val + j.val) : ℚ) := by
  decide +kernel

theorem A26_is_hankel : ∀ i j : Fin 26, A26 i j = (s (i.val + j.val) : ℚ) := by
  decide +kernel

end Principia.MathDB.P375936
