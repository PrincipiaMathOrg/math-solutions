/-
The order filtration on multivariate polynomials, and how differential operators move it.

This module is CAMPAIGN-AGNOSTIC.  It mentions no determinant, no moment and no zeta
function; it is about `MvPolynomial` and the ideal generated by the variables, so it lives in
`Common/` where the next campaign can find it.

WHY IT EXISTS.  The write-up for MathDB #322495 (Nuttall's Conjecture 3) proves its vanishing
theorem with a single sentence of commutative algebra:

  *"A differential operator of order at most `d` with polynomial coefficients maps `m^R` into
  `m^{max(R-d,0)}`: each derivative lowers total degree by at most one, and multiplication by a
  polynomial cannot lower it."*

Everything else in that proof is bookkeeping about which operator appears; this is the step
that does the work, and it is true of any polynomial ring in any number of variables.

WHAT IS PROVED
* `MinDeg p N` — every monomial of `p` has total degree at least `N`.  This is membership in
  `m^N` for `m = (X_1, …, X_n)`, stated in the form that is checkable monomial by monomial.
* `MinDeg_mul_left` — multiplication by an ARBITRARY polynomial cannot lower the order, and
  `MinDeg_mul` — orders ADD across a product, which is what gives the Vandermonde factor its
  order for free.
* **`MinDeg_pderiv`** — a partial derivative lowers the order by AT MOST ONE.
* `IsOrderLE D d` — an inductive characterisation of "differential operator of order at most
  `d` with polynomial coefficients": closed under multiplication by a polynomial, identity,
  sums, composition (orders add), and one `pderiv` costing 1.
* **`MinDeg_of_isOrderLE`** — the write-up's sentence: `IsOrderLE D d` and `MinDeg p N` give
  `MinDeg (D p) (N - d)`.  Truncated subtraction is exactly the `max(N-d, 0)` of the source.
* `coeff_eq_zero_of_degree_lt` — the consequence actually consumed: below the order, every
  coefficient vanishes.

ABSENT FROM MATHLIB, and measured rather than assumed: there is **no `coeff_pderiv`, no
`support_pderiv` and no `totalDegree_pderiv`** at this pin — grepped across the library, zero
hits for each.  `MinDeg_pderiv` is therefore proved from `MvPolynomial.as_sum` plus
`pderiv_monomial` and the additivity of a `Derivation`, rather than from a coefficient formula.
Mathlib does have the *upward* filtration `MvPolynomial.degreesLE`; the downward one used here
has no counterpart.
-/
import Mathlib.Algebra.MvPolynomial.PDeriv
import Mathlib.Algebra.MvPolynomial.Degrees
-- `Finsupp.degree` lives here and is NOT pulled in by `MvPolynomial.Degrees`, despite that
-- file being entirely about degrees.  Without it every `m.degree` fails as an invalid field
-- projection, and the cascade of "failed to synthesize instance" errors that follows points
-- everywhere except at the missing import.
import Mathlib.Data.Finsupp.Weight
-- `support_neg` / `coeff_neg` live here, NOT in `PDeriv` or `Degrees`.  Second instance
-- today of the same shape: a missing import reports as an UNKNOWN CONSTANT naming a lemma
-- that plainly exists, which reads as a rename rather than as a missing file.
import Mathlib.Algebra.MvPolynomial.CommRing

set_option autoImplicit false

namespace Principia.Common.PolynomialOrderFiltration

open MvPolynomial Finsupp

variable {σ : Type*} {R : Type*} [CommRing R]

/-- `MinDeg p N` : every monomial occurring in `p` has total degree at least `N`.  Equivalently
`p ∈ m^N` for the ideal `m` generated by the variables. -/
def MinDeg (p : MvPolynomial σ R) (N : ℕ) : Prop :=
  ∀ m ∈ p.support, N ≤ m.degree

theorem MinDeg_zero (N : ℕ) : MinDeg (0 : MvPolynomial σ R) N := by
  intro m hm; simp at hm

/-- Every polynomial has order at least `0` — the filtration starts at the whole ring. -/
theorem MinDeg_of_le_zero (p : MvPolynomial σ R) : MinDeg p 0 := by
  intro m _; exact Nat.zero_le _

theorem MinDeg_mono {p : MvPolynomial σ R} {M N : ℕ} (h : M ≤ N) (hp : MinDeg p N) :
    MinDeg p M := fun m hm => le_trans h (hp m hm)

theorem MinDeg_monomial {m : σ →₀ ℕ} {a : R} {N : ℕ} (h : N ≤ m.degree) :
    MinDeg (monomial m a) N := by
  classical
  intro s hs
  rcases eq_or_ne a 0 with rfl | ha
  · simp at hs
  · rw [MvPolynomial.support_monomial, if_neg ha] at hs
    simp only [Finset.mem_singleton] at hs
    subst hs; exact h

theorem MinDeg_add {p q : MvPolynomial σ R} {N : ℕ} (hp : MinDeg p N) (hq : MinDeg q N) :
    MinDeg (p + q) N := by
  classical
  intro m hm
  rcases Finset.mem_union.mp (MvPolynomial.support_add hm) with h | h
  · exact hp m h
  · exact hq m h

theorem MinDeg_neg {p : MvPolynomial σ R} {N : ℕ} (hp : MinDeg p N) : MinDeg (-p) N := by
  -- via `coeff_neg`: `MvPolynomial.support_neg` needs an instance that is not available here
  intro m hm
  rw [MvPolynomial.support_neg] at hm
  exact hp m hm

theorem MinDeg_sub {p q : MvPolynomial σ R} {N : ℕ} (hp : MinDeg p N) (hq : MinDeg q N) :
    MinDeg (p - q) N := by
  rw [sub_eq_add_neg]
  exact MinDeg_add hp (MinDeg_neg hq)

/-- A single variable has order at least `1`.  Proved through `coeff_X'` rather than by
rewriting with `MvPolynomial.X`, which is a `def` and does not unfold under `rw`; and stated
without `[Nontrivial R]`, since over a trivial ring the support is empty and the claim is
vacuous rather than false. -/
theorem MinDeg_X (i : σ) : MinDeg (X i : MvPolynomial σ R) 1 := by
  classical
  intro m hm
  have hm' : m = Finsupp.single i 1 := by
    by_contra hne
    rw [MvPolynomial.mem_support_iff] at hm
    exact hm (by rw [MvPolynomial.coeff_X]; exact if_neg (fun h => hne h.symm))
  subst hm'
  simp [Finsupp.degree]

theorem MinDeg_sum {ι : Type*} {s : Finset ι} {f : ι → MvPolynomial σ R} {N : ℕ}
    (h : ∀ i ∈ s, MinDeg (f i) N) : MinDeg (∑ i ∈ s, f i) N := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using MinDeg_zero (σ := σ) (R := R) N
  | insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact MinDeg_add (h a (Finset.mem_insert_self a s))
        (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

/-- **Orders ADD across a product.**  This is what hands the Vandermonde-squared factor its
order without computing a single coefficient. -/
theorem MinDeg_mul {p q : MvPolynomial σ R} {M N : ℕ} (hp : MinDeg p M) (hq : MinDeg q N) :
    MinDeg (p * q) (M + N) := by
  classical
  intro m hm
  obtain ⟨d, hd, e, he, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul p q hm)
  have : (d + e).degree = d.degree + e.degree := map_add Finsupp.degree d e
  rw [this]
  exact Nat.add_le_add (hp d hd) (hq e he)

/-- **Multiplication by an ARBITRARY polynomial cannot lower the order.** -/
theorem MinDeg_mul_left (q : MvPolynomial σ R) {p : MvPolynomial σ R} {N : ℕ}
    (hp : MinDeg p N) : MinDeg (q * p) N := by
  have := MinDeg_mul (MinDeg_of_le_zero q) hp
  simpa using this

/-- **A partial derivative lowers the order by AT MOST ONE.**

Proved through `as_sum` and `pderiv_monomial`, because Mathlib has no `coeff_pderiv` or
`support_pderiv` at this pin. -/
theorem MinDeg_pderiv (i : σ) {p : MvPolynomial σ R} {N : ℕ} (hp : MinDeg p N) :
    MinDeg (pderiv i p) (N - 1) := by
  classical
  conv_lhs => rw [p.as_sum]
  rw [map_sum]
  refine MinDeg_sum ?_
  intro s hs
  rw [pderiv_monomial]
  refine MinDeg_monomial ?_
  -- `(s - single i 1).degree ≥ s.degree - 1 ≥ N - 1`
  have hsN : N ≤ s.degree := hp s hs
  have hstep : s.degree - 1 ≤ (s - single i 1).degree := by
    rcases Nat.eq_zero_or_pos (s i) with h0 | hpos
    · -- the derivative's coefficient is zero here, but the degree bound still holds
      have : s - single i 1 = s := by
        ext j
        by_cases hj : j = i
        · subst hj; simp [h0]
        · simp [hj]
      rw [this]; exact Nat.sub_le _ _
    · -- with `s i ≥ 1` the exponent vector splits, and `degree` is additive
      have hrec : (s - single i 1) + single i 1 = s := by
        ext j
        by_cases hj : j = i
        · subst hj
          simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]
          omega
        · simp [hj]
      have hone : (Finsupp.single i 1 : σ →₀ ℕ).degree = 1 := by
        simp [Finsupp.degree]
      have hadd := map_add Finsupp.degree (s - single i 1) (Finsupp.single i 1)
      rw [hrec, hone] at hadd
      omega
  omega

/-! ## Differential operators of bounded order -/

/-- **`IsOrderLE D d` : `D` is a differential operator of order at most `d` with polynomial
coefficients.**  This is the inductive reading of the write-up's phrase: multiplication by an
arbitrary polynomial is free, sums and the identity are free, composition adds orders, and one
partial derivative costs exactly one. -/
inductive IsOrderLE : (MvPolynomial σ R → MvPolynomial σ R) → ℕ → Prop
  | id : IsOrderLE id 0
  | mulLeft (q : MvPolynomial σ R) : IsOrderLE (fun p => q * p) 0
  | deriv (i : σ) : IsOrderLE (fun p => pderiv i p) 1
  | comp {D E : MvPolynomial σ R → MvPolynomial σ R} {d e : ℕ} :
      IsOrderLE D d → IsOrderLE E e → IsOrderLE (fun p => D (E p)) (d + e)
  | add {D E : MvPolynomial σ R → MvPolynomial σ R} {d : ℕ} :
      IsOrderLE D d → IsOrderLE E d → IsOrderLE (fun p => D p + E p) d
  | mono {D : MvPolynomial σ R → MvPolynomial σ R} {d e : ℕ} :
      d ≤ e → IsOrderLE D d → IsOrderLE D e

/-- **THE WRITE-UP'S SENTENCE, AS A THEOREM.**  A differential operator of order at most `d`
with polynomial coefficients maps order `N` into order `N - d`; the truncated subtraction is
exactly the source's `max(N - d, 0)`. -/
theorem MinDeg_of_isOrderLE {D : MvPolynomial σ R → MvPolynomial σ R} {d : ℕ}
    (hD : IsOrderLE D d) {p : MvPolynomial σ R} {N : ℕ} (hp : MinDeg p N) :
    MinDeg (D p) (N - d) := by
  induction hD generalizing p N with
  | id => simpa using hp
  | mulLeft q => simpa using MinDeg_mul_left q hp
  | deriv i => exact MinDeg_pderiv i hp
  | @comp D E d e _ _ ihD ihE =>
      have h1 : MinDeg (E p) (N - e) := ihE hp
      have h2 : MinDeg (D (E p)) (N - e - d) := ihD h1
      rw [Nat.sub_sub] at h2
      exact MinDeg_mono (by omega) h2
  | add _ _ ihD ihE => exact MinDeg_add (ihD hp) (ihE hp)
  | mono hde _ ih => exact MinDeg_mono (by omega) (ih hp)

/-- The consequence actually consumed downstream: **below the order, every coefficient
vanishes.** -/
theorem coeff_eq_zero_of_degree_lt {p : MvPolynomial σ R} {N : ℕ} (hp : MinDeg p N)
    {m : σ →₀ ℕ} (hm : m.degree < N) : p.coeff m = 0 := by
  by_contra hne
  exact absurd (hp m (MvPolynomial.mem_support_iff.mpr hne)) (by omega)

end Principia.Common.PolynomialOrderFiltration
